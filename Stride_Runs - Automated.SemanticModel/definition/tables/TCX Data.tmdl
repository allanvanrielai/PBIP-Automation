	column 'Interval Detail' =
			
			
			If(MOD('TCX Data'[Lap Number], 2) = 0, 'TCX Data'[Interval Number] & " (" & 'TCX Data'[Lap Number] & ")" & " - Rec", 'TCX Data'[Interval Number] & " (" & 'TCX Data'[Lap Number] & ")" & " - Int")
		lineageTag: d411bce4-c121-4af9-9266-1601fb0bdce3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'TP Seconds Indicator' = ```
			IF(
			    'TCX Data'[Lap Start Time] = 'TCX Data'[TP Time],
			    0, 
			    IF(MOD(SECOND('TCX Data'[TP Time - Only]), 5) > 0, 1, 0)
			)
			```
		formatString: 0
		lineageTag: a53d2e20-14c6-4075-bc52-e00e3cfcc197
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

