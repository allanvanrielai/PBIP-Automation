	column TotalSeconds = HOUR('TCX Data'[TP Time]) * 3600 + MINUTE('TCX Data'[TP Time]) * 60 + SECOND('TCX Data'[TP Time])
		formatString: 0
		lineageTag: d6b15e66-d00a-4d9f-beee-ac54729ea765
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column SecondsIntoRun =
			VAR StartTime = CALCULATE(
			MIN('TCX Data'[TP Time - Only]),
			ALLEXCEPT('TCX Data', 'TCX Data'[Run Date])
			)
			RETURN
			DATEDIFF(StartTime, 'TCX Data'[TP Time - Only], SECOND)
		dataType: int64
		formatString: 0
		lineageTag: 19920460-c5ee-44ff-8b1d-37d0226a62d5
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

