	column 'The Lap Number' = ```
			
			FORMAT('TCX Data'[Run Date],"yyyy/mm/dd") & "_" & 
			RANKX(FILTER('TCX Data','TCX Data'[Id]=EARLIER('TCX Data'[Id])
			),
			'TCX Data'[Lap Start Time],
			,
			ASC,
			Dense
			)
			```
		lineageTag: 6dd8816a-c15c-48ce-90de-cabd7be96279
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column DateDetail = ```
			
			FORMAT('TCX Data'[Run Date], "yyyy/MM/dd")
			    & " ("
			    & RELATED('Stride Runs'[Details])
			    & "; Ave Pace: "
			    & FORMAT(RELATED('Stride Runs'[Run Ave Pace]), "mm:ss")
			   
			
			```
		lineageTag: 22dba94b-50d3-46fa-bf44-59d438fcb2be
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column CoralanDetail = "" & RELATED('Stride Runs'[Coralan])
