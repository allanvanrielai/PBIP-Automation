		lineageTag: 4bc8b034-12a6-4c4b-b273-c539dd8c0cee
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Month Week' =
			
			
			VAR DaySun2Mon = WEEKDAY(Dates[Date])
			
			VAR FirstDayDate  = Date(YEAR(Dates[Date]), MONTH(Dates[Date]), 1)
			
			// VAR TheDay = IF(WEEKDAY(Dates[Date]) = 1,7,WEEKDAY(Dates[Date]) - 1)
			VAR TheDay = IF(WEEKDAY(FirstDayDate) = 1,7,WEEKDAY(FirstDayDate) - 1)
			
			VAR WeekEndsOnDay = (7 - TheDay) + 1
			
			VAR DayOfMonth = DAY(Dates[Date])
			
			//=IF(F2 < (SUM(E2 + 1)),1, IF(AND(F2>E2,F2 < SUM(E2 + 8)),2,IF(AND(F2 > SUM(E2 + 7), F2 < SUM(E2 + 15)),3,IF(AND(F2 > SUM(E2 + 14), F2 < SUM(E2 + 22)),4,IF(AND(F2 > SUM(E2 + 21), F2 < SUM(E2 + 29)),5,6)))))
			VAR MonthWeek =
			IF(DayOfMonth < (WeekEndsOnDay + 1),1, IF(AND(DayOfMonth > WeekEndsOnDay,DayOfMonth < (WeekEndsOnDay + 8)),2,IF(AND(DayOfMonth > (WeekEndsOnDay + 7), DayOfMonth < (WeekEndsOnDay + 15)),3,IF(AND(DayOfMonth > (WeekEndsOnDay + 14), DayOfMonth < (WeekEndsOnDay + 22)),4,IF(AND(DayOfMonth > (WeekEndsOnDay + 21), DayOfMonth < (WeekEndsOnDay + 29)),5,6)))))
			
			RETURN
			    MonthWeek
		isHidden
		formatString: 0
		lineageTag: b61ce9d4-d008-4e32-b034-d146e379e146
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

