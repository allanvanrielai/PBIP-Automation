	column RundDateTime = CONCATENATE(FORMAT('Stride Runs'[Date], "dddd") & ", " & FORMAT('Stride Runs'[Coralan],"yyyy/mm/dd") & " @ " & 'Stride Runs'[Time] & " - ",'Stride Runs'[Details])
		lineageTag: 025fd9d8-ebd7-4ef2-99d8-8f526b670c5f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Run Ave Pace Total Secs' = ```
			
			    
			HOUR('Stride Runs'[Run Ave Pace]) * 60
			    + MINUTE('Stride Runs'[Run Ave Pace])
			
			```
		formatString: 0
