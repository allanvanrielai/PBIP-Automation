	column 'Running Ave HR' =
			
			DIVIDE(
			    CALCULATE(
			        SUM('Splits CSV Input'[Avg HR]),
			        'Splits CSV Input'[Step Type] = "Run"
			    ),
			    CALCULATE(
			        COUNT('Splits CSV Input'[Avg HR]),
			        'Splits CSV Input'[Step Type] = "Run"
			    )
			)
		lineageTag: 527d7b5c-00d6-4be7-8386-071a29838ccf
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column FONTCOLOUR = ```
			
			SWITCH(
			    TRUE(),
			    'Stride Runs'[Alarm] = 3 || 'Stride Runs'[Exhaustion (0 - 10)] > 8.5 || 'Stride Runs'[Others Say?] > 8.5, "RED", 
			    'Stride Runs'[Alarm] = 2 || 'Stride Runs'[Exhaustion (0 - 10)] > 6 || 'Stride Runs'[Others Say?] > 6, "ORANGE",  
			    'Stride Runs'[Alarm] = 1 || 'Stride Runs'[Exhaustion (0 - 10)] > 4 || 'Stride Runs'[Others Say?] > 4, "BLUE", 
			    "BLACK"  -- Default (Black)
			)
			```
		lineageTag: 1ad0e8d5-1240-47b7-8380-3a2e13c67027
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column RedTimeInSeconds = ```
			
			
			    VAR vHrSecs =  CONVERT(Left('Stride Runs'[Red: Max 90-100% -  153-170],2),INTEGER) * 3600
			    VAR vMinSecs = CONVERT(MID('Stride Runs'[Red: Max 90-100% -  153-170],4,2),INTEGER) * 60
			    VAR vSecSecs =  CONVERT(Right('Stride Runs'[Red: Max 90-100% -  153-170],2),INTEGER) * 1
			    VAR tot = vHrSecs + vMinSecs + vSecSecs
			
			RETURN tot
			```
		formatString: 0
		lineageTag: ebf12572-99e2-4939-9df4-be98a42b0458
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

